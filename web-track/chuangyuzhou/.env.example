# Loaded by tools/start.mjs only. No quotes or shell expressions.
CZB_YUZHOU_HOST=127.0.0.1
CZB_YUZHOU_PORT=4396
# local: open the loopback URL. web: serve through your HTTPS reverse proxy.
CZB_YUZHOU_MODE=local
# Required only in web mode, e.g. https://workbench.example.com (no path).
CZB_YUZHOU_PUBLIC_ORIGIN=
# Copy this template to the ignored .env file; keep this example free of secrets.
# Empty key leaves the signed-in settings page available. Restart after changes.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Terminal values for MODE, PUBLIC_ORIGIN and the two DEEPSEEK variables override .env.
# Never commit .env or add passwords, legacy data paths or setup tokens.
