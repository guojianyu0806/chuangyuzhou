[Unit]
Description=Yuzhou private workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shiguang
Group=shiguang
WorkingDirectory=/opt/shiguang/current/backend
EnvironmentFile=/etc/shiguang/workbench.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/shiguang/agent-home
Environment=HERMES_HOME=/var/lib/shiguang/agent-home/.hermes
ExecStart=/usr/bin/node /opt/shiguang/current/backend/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/.hermes/hermes-agent
BindReadOnlyPaths=/home/ubuntu/.local/share/uv/python
InaccessiblePaths=-/home/ubuntu/.hermes/hermes-agent/.env
ReadWritePaths=/var/lib/shiguang
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=100
MemoryMax=1800M
MemoryHigh=1400M

[Install]
WantedBy=multi-user.target
