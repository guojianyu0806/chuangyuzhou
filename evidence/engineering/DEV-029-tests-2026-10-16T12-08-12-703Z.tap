="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v17H3z M3 9h18 M8 9v12 M14 9v12 M3 15h18 M7 2v4 M17 2v4"/></svg></span><span class="wb-palette-copy"><strong>学期课表</strong><small>已放置 · 可以挪动</small></span><span class="wb-block-mini" aria-hidden="true"><i></i><i></i><i></i></span></button><button type="button" class="wb-palette-item is-placed" data-palette-group="builtin" data-palette-search-text="比赛 跟踪截止节点、准备清单与参赛资料。" data-place-source="competitions" aria-label="选择比赛方块" aria-pressed="false" title="跟踪截止节点、准备清单与参赛资料。"><span class="wb-block-icon" style="--block-color:#dff868"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22V3c5-3 9 3 14 0v10c-5 3-9-3-14 0"/></svg></span><span class="wb-palette-copy"><strong>比赛</strong><small>已放置 · 可以挪动</small></span><span class="wb-block-mini" aria-hidden="true"><i></i><i></i><i></i></span></button></div><p class="wb-palette-empty" data-palette-empty hidden>这里还没有匹配的方块。试试其他分类或创建一个。</p></aside>
        <section class="wb-placement-board" aria-label="摆放工作台方块"><div class="wb-placement-toolbar"><strong>你的工作台</strong><div class="wb-placement-navigation" role="group" aria-label="搭建画布视野"><button type="button" data-place-action="zoom-out" aria-label="缩小搭建画布">−</button><button type="button" data-place-action="zoom-reset" aria-label="恢复搭建画布为100%" title="恢复100%大小">100%</button><button type="button" data-place-action="zoom-in" aria-label="放大搭建画布">+</button><button type="button" class="btn" data-place-action="fit">看全画布</button></div><div class="wb-placement-layout-actions"><button type="button" class="btn" data-place-action="arrange">整齐排列</button><button type="button" class="btn" data-place-action="undo" disabled>撤销上次摆放</button></div></div>
        <p class="wb-placement-hint" role="status" aria-live="polite">从左边拖入方块；双击右边已有方块，进入对应内容。</p>
        <div class="wb-placement-stage" tabindex="0" aria-label="方块摆放画布；选择方块后点击位置，方向键微调，回车放下，Escape取消" aria-describedby="wb-placement-help"><div class="wb-placement-ghost" hidden aria-hidden="true"></div><p class="wb-stage-empty" hidden>从左边拿一个方块，放在这里。</p></div>
        <div class="wb-placement-inspector"><span data-place-selection>直接拖动画布里的方块，就能移动它。</span><div><button type="button" data-place-action="left" aria-label="所选方块向左移动" disabled>←</button><button type="button" data-place-action="up" aria-label="所选方块向上移动" disabled>↑</button><button type="button" data-place-action="down" aria-label="所选方块向下移动" disabled>↓</button><button type="button" data-place-action="right" aria-label="所选方块向右移动" disabled>→</button><button type="button" data-place-action="cancel" disabled>取消选择</button></div></div>
        <footer class="wb-placement-footer" id="wb-placement-help"><span>拖动空白处平移 · Ctrl / ⌘ + 滚轮缩放 · 空格拖动或中键也可平移</span><span>双击或回车打开已有方块；待放方块用回车放下，Esc取消。</span></footer></section></div></section></div>
        <section class="wb-custom-list" aria-label="我的自定义方块"><div class="wb-section-head"><div><h2>我的自定义方块</h2><p>同一场景可以创建多份；编辑内容、让 AI 改造，或收起后保留记录。</p></div><button type="button" class="btn" data-wb-action="create-block"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14 M5 12h14"/></svg> 创建方块</button></div><ul><li><span><strong>演示讲解提纲 · 示例</strong><small>便签</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev012-narration">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev012-narration">编辑</button></li><li><span><strong>预演观察表 · 示例</strong><small>记录表</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev012-observations">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev012-observations">编辑</button></li><li><span><strong>会议记录便笺 · 示例</strong><small>便签</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-note">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-note">编辑</button></li><li><span><strong>出门前检查 · 示例</strong><small>清单</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-checklist">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-checklist">编辑</button></li><li><span><strong>常用资料入口 · 示例</strong><small>网址收藏</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-links">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-links">编辑</button></li><li><span><strong>内容整理进度 · 示例</strong><small>进度</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-progress">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-progress">编辑</button></li><li><span><strong>下一次创作回顾 · 示例</strong><small>重要日期</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-countdown">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-countdown">编辑</button></li><li><span><strong>阅读与表达清单 · 示例</strong><small>记录表</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-table">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-table">编辑</button></li><li><span><strong>随手计算器 · 示例</strong><small>交互小程序</small></span><button type="button" class="btn" data-wb-action="open-block" data-id="block:showcase-dev019-miniapp">打开</button><button type="button" class="btn" data-wb-action="edit-block" data-id="block:showcase-dev019-miniapp">编辑</button></li></ul></section>
        <details class="wb-advanced"><summary>模板与更多设置 <span>更换组合、修改名称、管理模块和空间</span></summary><section class="panel"><h3>起始资料整理</h3><p>把已有起始资料整理成日常计划与参考，收起未实际发生的占位历史。先预览，再保存。</p><button type="button" class="btn" data-wb-action="daily-review">预览整理</button><button type="button" class="btn" data-wb-action="daily-undo" hidden>撤销本次整理</button></section><div class="wb-columns"><div class="wb-materials">
          <section class="wb-library" aria-labelledby="wb-library-heading"><div class="wb-section-head"><div><h2 id="wb-library-heading">模块库</h2><p>按需加入；收起后，已有资料仍然保留。</p></div><span class="wb-section-caption">9 种可选模块</span></div>
            <div class="wb-library-list"><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#AE88FF"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h6a4 4 0 0 1 3 2 4 4 0 0 1 3-2h6v15h-6a4 4 0 0 0-3 2 4 4 0 0 0-3-2H3z M12 6v15"/></svg></span><div><h3>课程空间</h3><p>按课程或研究主题保存资料与笔记。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="courses" disabled aria-label="已加入课程空间"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#D8F649"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5z M6 11v6c4 3 8 3 12 0v-6 M22 9v7"/></svg></span><div><h3>英语</h3><p>词汇、阅读、听力和学习记录。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="english" disabled aria-label="已加入英语"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#FF9CCE"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16l2 12v4H2v-4z M2 15h6l2 3h4l2-3h6"/></svg></span><div><h3>灵感收集箱</h3><p>随手保存文字、链接和附件，稍后整理。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="inbox" disabled aria-label="已加入灵感收集箱"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#63E6DC"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 5-5 M21 11v1a9 9 0 1 1-5-8"/></svg></span><div><h3>备忘与待办</h3><p>记录要做的事，安排日期与优先级。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="tasks" disabled aria-label="已加入备忘与待办"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#9DC5FF"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v18h17 M8 16v-4 M13 16V7 M18 16v-7"/></svg></span><div><h3>生活回顾</h3><p>查看完成记录与学习活动。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="review" disabled aria-label="已加入生活回顾"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#FFBC7C"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 8V5a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h15v11H5a3 3 0 0 1-3-3V6 M20 12h-5v5h5 M16 14.5h.01"/></svg></span><div><h3>记账</h3><p>管理日常收支与独立项目账本。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="ledger" disabled aria-label="已加入记账"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#FF9CCE"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v16H4z M8 2v6 M16 2v6 M4 11h16"/></svg></span><div><h3>日历</h3><p>安排计划、标注日期并查看关联事项。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="calendar" disabled aria-label="已加入日历"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#8EDBE8"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v17H3z M3 9h18 M8 9v12 M14 9v12 M3 15h18 M7 2v4 M17 2v4"/></svg></span><div><h3>学期课表</h3><p>按教学周和节次管理上课安排。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="timetable" disabled aria-label="已加入学期课表"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article><article class="wb-material is-added"><span class="wb-module-glyph" style="--wb-module-color:#D8F649"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22V3c5-3 9 3 14 0v10c-5 3-9-3-14 0"/></svg></span><div><h3>比赛</h3><p>跟踪截止节点、准备清单与参赛资料。</p></div><button type="button" class="wb-add-button" data-wb-action="add" data-id="competitions" disabled aria-label="已加入比赛"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span>已加入</span></button></article></div>
          </section>
          <section class="wb-template-section" aria-labelledby="wb-template-heading"><div class="wb-section-head"><div><h2 id="wb-template-heading">从一套组合开始</h2><p>模板提供起点，之后可以继续修改。</p></div></div><div class="wb-template-grid"><button type="button" class="wb-template wb-template-blank" data-wb-action="template" data-id="blank"><span class="wb-template-title">从空白开始<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">只保留 AI伙伴，按自己的需要逐步添加模块。</span><span class="wb-template-foot">保留 AI，自由选择模块<span>预览组合</span></span></button><button type="button" class="wb-template " data-wb-action="template" data-id="project"><span class="wb-template-title">项目推进<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">从任务、日程、灵感和项目收支开始。</span><span class="wb-template-foot">AI + 4 个模块<span>预览组合</span></span></button><button type="button" class="wb-template " data-wb-action="template" data-id="research"><span class="wb-template-title">研究与创作<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">围绕资料、笔记、灵感与推进计划搭建。</span><span class="wb-template-foot">AI + 4 个模块<span>预览组合</span></span></button><button type="button" class="wb-template " data-wb-action="template" data-id="student"><span class="wb-template-title">学习与课程<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">连接课程资料、学期课表、待办与英语练习。</span><span class="wb-template-foot">AI + 5 个模块<span>预览组合</span></span></button><button type="button" class="wb-template " data-wb-action="template" data-id="life"><span class="wb-template-title">日常生活<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">把日程、待办、收支和生活记录放在一起。</span><span class="wb-template-foot">AI + 5 个模块<span>预览组合</span></span></button><button type="button" class="wb-template " data-wb-action="template" data-id="full"><span class="wb-template-title">完整宇宙<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg></span><span class="wb-template-description">启用原宇宙的全部内置模块，保留完整个人工作台。</span><span class="wb-template-foot">AI + 9 个模块<span>预览组合</span></span></button></div></section>
        </div>
        <aside class="wb-composition" aria-labelledby="wb-composition-heading"><div class="wb-section-head"><div><h2 id="wb-composition-heading">我的组合</h2><p>顺序对应模块列表；侧栏顺序在上方“侧栏导航”中调整。</p></div><span class="wb-count">10</span></div>
          
          <ol class="wb-slot-list"><li class="wb-slot" data-wb-module="ai"><span class="wb-slot-index" aria-hidden="true">01</span><div class="wb-slot-body"><div class="wb-slot-top"><span class="wb-module-glyph" style="--wb-module-color:#B3A0FF"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z M20 2v4 M18 4h4"/></svg></span><div class="wb-slot-name"><strong>AI伙伴</strong><small>常驻智能助手</small></div><button type="button" class="wb-icon-button" data-wb-action="rename-module" data-id="ai" aria-label="重命名AI伙伴" title="重命名模块"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 3 5 5-12 12-6 1 1-6z M14 5l5 5"/></svg></button></div><div class="wb-slot-controls"><button type="button" class="wb-order-button" data-wb-action="up" data-id="ai" disabled aria-label="上移AI伙伴"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4 m6-6-6 6 6 6"/></svg><span>上移</span></button><button type="button" class="wb-order-button" data-wb-action="down" data-id="ai"  aria-label="下移AI伙伴"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16 m-6-6 6 6-6 6"/></svg><span>下移</span></button><span class="wb-always">始终可用</span></div></div></li><li class="wb-slot" data-wb-module="courses"><span class="wb-slot-index" aria-hidden="true">02</span><div class="wb-slot-body"><div class="wb-slot-top"><span class="wb-module-glyph" style="--wb-module-color:#AE88FF"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke